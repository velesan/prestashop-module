# LF everywhere, also in the Windows working copy: the Addons validator
# (php-cs-fixer line_ending) flags CRLF files when the package is zipped from it
* text=auto eol=lf

# Development-only files left out of the Addons package built with `git archive`
/.gitattributes export-ignore
/.gitignore export-ignore
/.php-cs-fixer.dist.php export-ignore
/.vscode export-ignore
/composer.json export-ignore
/composer.lock export-ignore
